 })}\n    </>\n  );\n}\n\n// ─── Streaming assistant bubble ───────────────────────────────────────────────\n\nfunction AssistantBubble({\n  msg,\n  reduceMotion,\n}: {\n  msg: ChatMessage;\n  reduceMotion: boolean | null;\n}): ReactElement {\n  // Only stream new messages (id starts with \"assistant-\"), not welcome or history\n  const isNew = msg.id.startsWith(\"assistant-\");\n  const shouldStream = isNew && !reduceMotion;\n  const { displayed, done } = useTypewriter(msg.content, shouldStream);\n  const visible = shouldStream ? displayed : msg.content;\n\n  return (\n    <div className=\"max-w-[85%] rounded-2xl rounded-tl-sm bg-white/[0.06] px-4 py-3 text-sm leading-relaxed text-white/85 ring-1 ring-white/[0.06]\">\n      {renderMarkdown(visible)}\n      {!done && shouldStream ? (\n        <span\n          className=\"ml-0.5 inline-block h-[1em] w-[2px] translate-y-[1px] animate-pulse rounded-sm bg-violet-400 align-middle\"\n          aria-hidden\n        />\n      ) : null}\n    </div>\n  );\n}\n\n// ─── Component ────────────────────────────────────────────────────────────────\n\nexport function LandingAssistantFab(): ReactElement {\n  const reduceMotion = useReducedMotion();\n  const [open, setOpen] = useState(false);\n  const [session, setSession] = useState<PersistedSession>(() => loadSession());\n  const [draft, setDraft] = useState(\"\");\n  const [sending, setSending] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const dragged = useRef(false);\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n  const inputRef = useRef<HTMLTextAreaElement>(null);\n  // Keep a ref to the latest session so send() always reads current state\n  const sessionRef = useRef(session);\n  useEffect(() => { sessionRef.current = session; }, [session]);\n\n  // Scroll to bottom when messages change or panel opens\n  useEffect(() => {\n    if (open) {\n      messagesEndRef.current?.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [session