                    "Text": "\"\"\"\nWhatsApp audio transcription via Pollinations STT.\n\nDownloads audio bytes from Meta's Graph API and transcribes them using\nPollinations /v1/audio/transcriptions (model=universal-2, 99 languages).\n\nReturns the transcribed text string on success, or None on any failure.\n\nNOTE: The audio transcription endpoint lives at https://gen.pollinations.ai —\nNOT at POLLINATIONS_BASE_URL (which points to the text/chat completions base).\nThe audio base URL is hardcoded here to avoid routing to the wrong host.\n\"\"\"\n\nfrom typing import Optional\n\nimport httpx\n\nfrom ....config.my_settings import settings\nfrom ....utils.my_logger import get_logger\nfrom .audio import download_audio_media\n\nlogger = get_logger(\"WHATSAPP_AUDIO_TRANSCRIPTION\")\n\n# Pollinations audio API base — always gen.pollinations.ai regardless of POLLINATIONS_BASE_URL\n_POLLINATIONS_AUDIO_BASE_URL = \"https://gen.pollinations.ai\"\n_STT_ENDPOINT = \"/v1/audio/transcriptions\"\n\n# Primary model: AssemblyAI Universal-2 — 99 languages, fast, multilingual\n_STT_MODEL = \"universal-2\"\n\n_DEFAULT_MIME_TYPE = \"audio/ogg\"\n_DEFAULT_FILENAME = \"whatsapp_voice.ogg\"\n\n\ndef _get_pollinations_api_key() -> Optional[str]:\n    key = (settings.POLLINATIONS_API_KEY or \"\").strip()\n    return key or None\n\n\ndef _post_transcription(\n    client: httpx.Client,\n    endpoint: str,\n    headers: dict,\n    audio_bytes: bytes,\n    filename: str,\n    mime_type: str,\n    model: str,\n    media_id: str,\n) -> Optional[str]:\n    \"\"\"\n    POST audio bytes to Pollinations STT endpoint.\n    Returns transcript text on success, None on failure.\n    \"\"\"\n    response = client.post(\n        endpoint,\n        headers=headers,\n        files={\"file\": (filename, audio_bytes, mime_type)},\n        data={\"model\": model},\n    )\n\n    if response.status_code != 200:\n        logger.warning(\n            \"Pollinations STT returned %s for media_id=%s model=%s: %s\",\n            response.status_code,\n            media_id,\n            model,\n            response.text[:300],\n        )\n        return None\n\n    data = response.json()\n    transcript = (data.get(\"text\") or \"\").strip()\n\n    if not transcript:\n        logger.warning(\n            \"Pollinations STT returned empty transcript for media_id=%s model=%s\",\n            media_id,\n            model,\n        )\n        return None\n\n    return transcript\n\n\ndef transcribe_whatsapp_audio(\n    media_id: str,\n    mime_type: Optional[str] = None,\n) -> Optional[str]:\n    \"\"\"\n    Download a WhatsApp audio message and transcribe it via Pollinations STT.\n\n    Uses https://gen.pollinations.ai/v1/audio/transcriptions (model=universal-2).\n\n    Args:\n        media_id:  The audio media id from the WhatsApp webhook payload (msg[\"audio\"][\"id\"]).\n        mime_type: MIME type reported by Meta (e.g. \"audio/ogg; codecs=opus\"). Used as the\n                   Content-Type of the uploaded file. Defaults to \"audio/ogg\".\n\n    Returns:\n        Transcribed text (stripped) on success, or None if download or transcription fails.\n    \"\"\"\n    mid = (media_id or \"\").strip()\n    if not mid:\n        logger.warning(\"transcribe_whatsapp_audio called with empty media_id\")\n        return None\n\n    api_key = _get_pollinations_api_key()\n    if not api_key:\n        logger.warning(\"POLLINATIONS_API_KEY not set; cannot transcribe audio\")\n        return None\n\n    # Step 1: download audio bytes from Meta\n    audio_bytes = download_audio_media(mid, timeout=60)\n    if not audio_bytes:\n        logger.warning(\"Audio download failed for media_id=%s\", mid)\n        return None\n\n    logger.info(\n        \"Audio downloaded media_id=%s size=%d bytes — sending to Pollinations STT\",\n        mid,\n        len(audio_bytes),\n    )\n\n    # Step 2: determine file mime type and filename\n    effective_mime = (mime_type or \"\").strip() or _DEFAULT_MIME_TYPE\n    if \"ogg\" in effective_mime:\n        filename = \"whatsapp_voice.ogg\"\n    elif \"mp4\" in effective_mime or \"m4a\" in effective_mime:\n        filename = \"whatsapp_voice.m4a\"\n    elif \"mpeg\" in effective_mime or \"mp3\" in effective_mime:\n        filename = \"whatsapp_voice.mp3\"\n    elif \"webm\" in effective_mime:\n        filename = \"whatsapp_voice.webm\"\n    elif \"wav\" in effective_mime:\n        filename = \"whatsapp_voice.wav\"\n    else:\n        filename = _DEFAULT_FILENAME\n\n    # Step 3: POST to Pollinations gen.pollinations.ai/v1/audio/transcriptions\n    endpoint = f\"{_POLLINATIONS_AUDIO_BASE_URL}{_STT_ENDPOINT}\"\n    headers = {\"Authorization\": f\"Bearer {api_key}\"}\n\n    try:\n        with httpx.Client(timeout=120) as client:\n            transcript = _post_transcription(\n                client=client,\n                endpoint=endpoint,\n                headers=headers,\n                audio_bytes=audio_bytes,\n                filename=filename,\n                mime_type=effective_mime,\n                model=_STT_MODEL,\n                media_id=mid,\n            )\n\n        if transcript:\n            logger.info(\n                \"Transcription success media_id=%s model=%s transcript_len=%d\",\n                mid,\n                _STT_MODEL,\n                len(transcript),\n            )\n            return transcript\n\n        logger.warning(\n            \"Transcription failed for media_id=%s — no transcript returned\",\n            mid,\n        )\n        return None\n\n    except Exception as exc:\n        logger.warning(\n            \"Pollinations STT request failed for media_id=%s: %s\",\n            mid,\n            exc,\n        )\n        return None"
